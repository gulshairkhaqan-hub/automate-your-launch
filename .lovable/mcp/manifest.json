{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zzdqjhrbhxybrxoaudlw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "automation-studio-mcp",
      "version": "0.1.0",
      "title": "Automation Studio"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the authenticated user's id and email for the current MCP session.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List captured leads from the Automation Studio contact form. Only accessible to admin users; RLS enforces access.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum number of leads to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "days": {
              "description": "Return leads created in the last N days.",
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "lead_stats",
        "title": "Lead stats",
        "description": "Summarize captured leads: total count and count in the last N days. Admin-only via RLS.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "days": {
              "description": "Window size in days for the recent count (default 30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
